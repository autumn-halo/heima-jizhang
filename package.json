{
  "name": "heima-jizhang",
  "productName": "黑马记账",
  "version": "1.0.0",
  "description": "黑马记账 - 个人本地记账软件",
  "main": "./out/main/index.js",
  "author": "黑马记账用户",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "node scripts/run-electron-vite.mjs preview",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --dir",
    "build:win": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "echarts": "^6.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "element-plus": "^2.14.7",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "pinia": "^4.1.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.6.4"
  }
}
